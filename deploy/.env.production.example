# Production environment. Copy to `.env` on the server and fill in real values.
# Never commit the real file.

APP_NAME="Webapp API"
APP_ENV=production
APP_DEBUG=false
LOG_FORMAT=json

# PostgreSQL (recommended). MySQL / SingleStore: DATABASE_ENGINE=mysql|singlestore with a
# mysql+asyncmy:// URL (and `pip install asyncmy`).
DATABASE_ENGINE=postgresql
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/DB_NAME

# Required: a unique random value of at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# The web app's public origin(s), comma separated or a JSON list.
BACKEND_CORS_ORIGINS=https://app.example.com

# Refresh cookie. Must be Secure in production (the app refuses to start otherwise).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Set when the API and web app are on sibling subdomains (e.g. .example.com).
COOKIE_DOMAIN=

# With more than one worker, use a shared store so the login limit is global.
RATE_LIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=10/minute

# Used once by: python -m app.cli create-admin   (remove the password afterwards)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=
