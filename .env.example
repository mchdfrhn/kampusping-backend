APP_NAME="HIS Standard Backend"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

API_V1_PREFIX=/api/v1

# Satu engine: postgresql | mysql | singlestore
DATABASE_ENGINE=postgresql
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/his_standard

# MySQL
# DATABASE_ENGINE=mysql
# DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/his_standard

# SingleStore
# DATABASE_ENGINE=singlestore
# DATABASE_URL=singlestoredb://user:password@host:3306/his_standard

# Optional named connections (kosongkan jika tidak dipakai)
DB_URL_PRIMARY=
DB_URL_IAM=
DB_URL_REFERENCE=

IAM_API_BASE_URL=
GROUP_ADMIN_ROLE_ID=1

BACKEND_CORS_ORIGINS=["http://localhost:3000"]
