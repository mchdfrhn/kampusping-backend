# Copy to `.env` for local development. Production: see deploy/.env.production.example.

APP_NAME="KampusPing API"
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Database --------------------------------------------------------------------------------
# Engines: postgresql | mysql | singlestore | sqlite (sqlite is for quick local tries only).
# The URL must use an async driver.
DATABASE_ENGINE=postgresql
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kampusping

# Zero-setup alternative:
# DATABASE_ENGINE=sqlite
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# MySQL / SingleStore (pip install asyncmy):
# DATABASE_ENGINE=mysql
# DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/kampusping

# --- Auth ------------------------------------------------------------------------------------
# Development placeholder. Production refuses it; use a random value of 32+ characters.
SECRET_KEY=change-me-development-only-secret-key-0000000000
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SAMESITE=lax
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10/minute

# First administrator, used by `python -m app.cli create-admin`.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=ChangeMe-12345

# --- CORS ------------------------------------------------------------------------------------
# Comma separated or a JSON list. The web app origin(s).
BACKEND_CORS_ORIGINS=http://localhost:3000
