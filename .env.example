# Copy to `.env` for local development. Production: see deploy/.env.production.example.

APP_NAME="KampusPing API"
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=text
# Defaults you rarely change:
# APP_VERSION=1.0.0
# API_V1_PREFIX=/api/v1

# --- Database --------------------------------------------------------------------------------
# Engines: postgresql | mysql | singlestore | sqlite (sqlite is for quick local tries only).
# The URL must use an async driver.
DATABASE_ENGINE=postgresql
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kampusping

# Log every SQL statement (very noisy, never in production).
# DATABASE_ECHO=false

# Zero-setup alternative:
# DATABASE_ENGINE=sqlite
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# MySQL / SingleStore (pip install asyncmy):
# DATABASE_ENGINE=mysql
# DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/kampusping

# --- Auth ------------------------------------------------------------------------------------
# Development placeholder. Production refuses it; use a random value of 32+ characters.
SECRET_KEY=change-me-development-only-secret-key-0000000000
# JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# REFRESH_COOKIE_NAME=refresh_token
# Secure defaults to true only when APP_ENV=production; leave unset in development (plain HTTP).
# COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Leave empty for a host-only cookie.
# COOKIE_DOMAIN=
# PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10/minute
# RATE_LIMIT_ENABLED=true
# "memory://" is per process; use a shared store (e.g. redis://...) with several API workers.
# RATE_LIMIT_STORAGE_URI=memory://

# First administrator, used by `python -m app.cli create-admin`.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=ChangeMe-12345

# Container entrypoint only (docker-entrypoint.sh): "true" applies migrations, seeds roles and creates
# the first administrator before starting the command. Never set it on the worker container.
# RUN_MIGRATIONS=false

# --- Scheduling ------------------------------------------------------------------------------
# IANA zone for the sending window and "today"; timestamps stay in UTC.
APP_TIMEZONE=Asia/Jakarta
WORKER_TICK_SECONDS=60

# --- WhatsApp provider -----------------------------------------------------------------------
# fake = in-memory provider for development; gateway = the WhatsApp gateway service.
WA_PROVIDER=fake
WA_GATEWAY_URL=http://127.0.0.1:8095
# Both are required (16+ characters, not "change-me...") when WA_PROVIDER=gateway; the gateway
# service must be configured with the same values. Placeholders only: never commit real ones.
WA_GATEWAY_API_KEY=
WA_WEBHOOK_SECRET=

# --- CORS ------------------------------------------------------------------------------------
# Comma separated or a JSON list. The web app origin(s).
BACKEND_CORS_ORIGINS=http://localhost:3000
